# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/

# PyInstaller build output
build/
dist/
*.spec
setup/version_info.txt

# Setup certificates (private — never commit)
setup/cert/

# Virtual environments
venv/
.venv/
env/

# IDE
.vscode/
*.suo
*.user

# Claude Code local settings — .claude/settings.json is TRACKED (project
# hook configuration, root CODE.md Enforcement); everything else under
# .claude/ (local overrides, session state) is not.
.claude/*
!.claude/settings.json
.claude/settings.local.json

# Generated assets (rebuilt from logo.svg)
assets/UltraVivid.ico

# Resolver runtime output (log + last-applied state)
logs/

# Generated per-set slot folders (embed local Python path; rebuilt via --write-slots)
shortcuts/*/

# Owner inbox - local only (root Rule #18)
UV/

# Claude Code working folder - never tracked (owner decree 2026-08-09)
.claude/
