{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python tests/run_guards.py --fast",
            "statusMessage": "Guards (structure + config)"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python tests/run_guards.py",
            "statusMessage": "Guards (all four)"
          }
        ]
      }
    ]
  }
}
